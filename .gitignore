# Real secrets/config — keep .env.example tracked, never the real one
.env

# Bind-mounted vault data — the master key and database live here
/data/

# Backup snapshots — timestamped dumps, not meant to be committed
/backup/*
!/backup/.gitkeep

# flock target for backup.sh/upgrade.sh's concurrent-invocation guard --
# just an empty lock handle, never has meaningful content.
/deploy.lock
