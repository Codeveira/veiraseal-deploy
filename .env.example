# Copy to .env and fill in before running docker compose.
#
#   cp .env.example .env

# Image to run. Build locally from ../veiraseal with `make build-image`,
# or point this at a registry tag once Veira Seal publishes one.
IMAGE_TAG=latest

# Admin password used ONLY on first `docker compose run --rm veira-init`.
# Not read again afterwards — the account it creates is a normal user you
# can change the password for once logged in.
VEIRA_ADMIN_PASSWORD=change-me-before-first-run

# Address the server binds to inside the container. Leave as-is unless you
# know why you're changing it.
VEIRA_LISTEN_ADDR=0.0.0.0:8200

# Set to 1 only if a reverse proxy you control (see nginx.conf.example) is
# the sole path to this container — it makes the audit log and rate
# limiter trust X-Forwarded-For, which is spoofable otherwise.
VEIRA_TRUST_PROXY=

# ── Monitoring (optional — docker-compose.monitoring.yml) ──────────────────
# Only read when that overlay is merged in:
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# GRAFANA_ADMIN_PASSWORD=change-me-too
